import importlib
cs = importlib.import_module('compress-string')

print(cs.uncompress_string(cs.compress_string('m')))
print(cs.uncompress_string(cs.compress_string('ma')))
print(cs.uncompress_string(cs.compress_string('mar')))
print(cs.uncompress_string(cs.compress_string('mart')))
print(cs.uncompress_string(cs.compress_string('marti')))
print(cs.uncompress_string(cs.compress_string('martin')))
